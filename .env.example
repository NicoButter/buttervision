# Copy to .env.local for persistent per-installation settings. Use KEY=VALUE
# lines only (no shell syntax). Variables exported by the process take precedence.
# AUTO recognizes an already initialized/UUID-authorized mounted volume only.
BUTTERVISION_PIZARRA_ENABLED=AUTO
BUTTERVISION_PIZARRA_MODE=AUTO
BUTTERVISION_PIZARRA_ROOT=/mnt/pizarra
# Recommended: set the filesystem UUID to reject another disk at this mountpoint.
BUTTERVISION_PIZARRA_VOLUME_UUID=
BUTTERVISION_PIZARRA_QUOTA_GB=400
BUTTERVISION_PIZARRA_MIN_FREE_GB=20
BUTTERVISION_PIZARRA_METRICS_ENABLED=true
# Optional Forge installation root. Known home locations are discovered automatically.
BUTTERVISION_FORGE_HOME=
# Optional additional checkpoint/LoRA directories, separated by the OS path separator.
BUTTERVISION_CHECKPOINT_DIRS=
BUTTERVISION_LORA_DIRS=
# Observational fractions of currently available RAM and VRAM (0 <= value < 1).
BUTTERVISION_PIZARRA_RAM_MARGIN_FRACTION=0.1
BUTTERVISION_PIZARRA_GPU_MARGIN_FRACTION=0.1
